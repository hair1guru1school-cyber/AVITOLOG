    "Project.categoryFolderId → Google Drive folder": "Папка категории/ниши на Google Drive",
    "Client.folderId → Google Drive folder": "Папка клиента на Google Drive",
    "workOrderWork[] → GoalProject.id": "Порядок отображения рабочих проектов"
  },

