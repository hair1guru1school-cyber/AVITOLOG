{
  "_meta": {
    "createdAt": "2026-04-24",
    "description": "Полная схема данных AVITOLOG: все ключи localStorage, структуры объектов, взаимосвязи между сущностями",
    "version": "2"
  },

  "localStorage_keys": {

    "ОБЩИЕ": {
      "avitolog_current_user": {
        "type": "string",
        "values": ["fil", "sasha"],
        "description": "Текущий активный профиль"
      },
      "avitolog_profile_bookmark": {
        "type": "string",
        "values": ["sasha"],
        "description": "Закладка профиля (последний открытый)"
      },
      "avitolog_drive_email": {
        "type": "string",
        "description": "Email Google Drive аккаунта (для Фила)"
      },
      "avitolog_sasha_email": {
        "type": "string",
        "description": "Email Саши (override)"
      },
      "avitolog_api_key": {
        "type": "string",
        "description": "Anthropic API ключ (вводит пользователь)"
      }
    },

    "ПРОФИЛЬ_ФИЛ": {
      "avitolog_projects": {
        "type": "JSON object",
        "schema": {
          "projects": "array of Project",
          "hiddenProjects": "array",
          "tasks": "array",
          "taskLog": "array"
        }
      },
      "avitolog_goals_v1": {
        "type": "JSON object",
        "schema": {
          "projects": "array of GoalProject",
          "customMetrics": "array",
          "pinnedMetrics": "array",
          "pinnedMetricsMain": "array",
          "totalKpFullOverride": "number",
          "workOrderWork": "array of goal IDs",
          "workTargetFilter": "boolean"
        }
      },
      "avitolog_clients": {
        "type": "JSON array of Client"
      },
      "crm_tasks_v1": {
        "type": "JSON array of Task"
      },
      "avitolog_assets_my_v2": {
        "type": "JSON array of AssetRow",
        "description": "Касса «мои» текущего месяца"
      },
      "avitolog_assets_sasha_v2": {
        "type": "JSON array of AssetRow",
        "description": "Касса «Саша» (видна у Фила)"
      },
      "avitolog_assets_base_v2": {
        "type": "JSON array of AssetRow",
        "description": "Базовый шаблон кассы"
      },
      "avitolog_goal_achievements_v1": {
        "type": "JSON object",
        "schema": {
          "events": "array of Achievement",
          "monthMilestones": "object { YYYY-MM: { 50k: bool, 100k: bool } }"
        }
      },
      "avitolog_goals_v1_month_YYYY-MM": {
        "type": "JSON object (snapshot)",
        "description": "Снимок воронки Фила за месяц"
      },
      "avitolog_assets_my_v2_month_YYYY-MM": {
        "type": "JSON array (snapshot)",
        "description": "Снимок кассы Фила за месяц"
      }
    },

    "ПРОФИЛЬ_САША": {
      "avitolog_projects_sasha": {
        "type": "JSON object",
        "schema": {
          "projects": "array of Project",
          "hiddenProjects": "array",
          "tasks": "array",
          "taskLog": "array"
        }
      },
      "avitolog_goals_v1_sasha": {
        "type": "JSON object",
        "schema": {
          "projects": "array of GoalProject",
          "customMetrics": "array",
          "pinnedMetrics": "array",
          "pinnedMetricsMain": "array",
          "totalKpFullOverride": "number",
          "workOrderWork": "array of goal IDs (stage=working)",
          "workTargetFilter": "boolean"
        }
      },
      "avitolog_clients_sasha": {
        "type": "JSON array of Client"
      },
      "crm_tasks_v1_sasha": {
        "type": "JSON array of Task"
      },
      "avitolog_assets_my_v2_sasha": {
        "type": "JSON array of AssetRow",
        "description": "Касса «мои» Саши (текущий месяц)"
      },
      "avitolog_assets_sasha_v2_sasha": {
        "type": "JSON array of AssetRow",
        "description": "Касса «Саша» Саши"
      },
      "avitolog_assets_base_v2_sasha": {
        "type": "JSON array of AssetRow",
        "description": "Базовый шаблон кассы Саши"
      },
      "avitolog_goal_achievements_v1_sasha": {
        "type": "JSON object",
        "schema": {
          "events": "array of Achievement",
          "monthMilestones": "object { YYYY-MM: { 50k: bool, 100k: bool } }"
        }
      },
      "avitolog_goals_v1_sasha_month_YYYY-MM": {
        "type": "JSON object (snapshot)",
        "description": "Снимок воронки Саши за месяц"
      },
      "avitolog_assets_my_v2_sasha_month_YYYY-MM": {
        "type": "JSON array (snapshot)",
        "description": "Снимок кассы Саши за месяц"
      },
      "avitolog_projects_sasha_month_YYYY-MM": {
        "type": "JSON object (snapshot)",
        "description": "Снимок проектов Саши за месяц"
      }
    },

    "НАСТРОЙКИ_САША": {
      "avitolog_projects_zoom_sasha": {
        "type": "string (number)",
        "example": "0.49999999999999994",
        "description": "Зум доски проектов"
      },
      "avitolog_projects_day_px_sasha": {
        "type": "string (number)",
        "example": "64",
        "description": "Пикселей на день (доска Гантта)"
      },
      "avitolog_projects_path_defaults_off_v1": {
        "type": "string",
        "example": "1",
        "description": "Отключение авто-path для клиентов"
      }
    },

    "РЕКЛАМА_CRM": {
      "crm_ads_expenses_v1": {
        "type": "JSON object",
        "schema": {
          "y": "string year",
          "m": "string month",
          "cells": "object { both_N: value | null }"
        },
        "description": "Расходы на рекламу текущего месяца"
      },
      "crm_ads_expenses_month_YYYY-MM": {
        "type": "JSON object (snapshot)",
        "schema": {
          "data": "object { both_N: value | null }",
          "year": "string",
          "month": "string"
        }
      },
      "crm_ads_links_v1": {
        "type": "JSON array",
        "schema": {
          "id": "string",
          "category": "telegram | vk | avito | sites",
          "icon": "string emoji",
          "label": "string",
          "url": "string",
          "snippet": "string",
          "avatar": "string"
        }
      },
      "crm_ads_posts_plan_v1": {
        "type": "JSON object",
        "schema": {
          "y": "string year",
          "m": "string month",
          "cells": "object { learn_N | agency_N: text }",
          "months": "object { YYYY-MM: cells snapshot }"
        }
      },
      "crm_ads_last_month_v2": {
        "type": "string",
        "example": "2026-04",
        "description": "Последний активный месяц рекламы"
      }
    },

    "ТЕНЕВОЕ_ХРАНИЛИЩЕ": {
      "_crm_shadow_last_snap": {
        "type": "string ISO date",
        "description": "Дата последнего снимка IndexedDB"
      }
    },

    "EMAIL_BASED_KEYS": {
      "description": "Ключи привязанные к email аккаунта Google Drive (формат: _emp_EMAIL_KEY)",
      "examples": [
        "avitolog_assets_my_v2__emp_cyplakovaleksandr153_gmail_com",
        "avitolog_assets_my_v2__emp_cyplakovaleksandr153_gmail_com_month_2026-04",
        "avitolog_assets_sasha_v2__emp_cyplakovaleksandr153_gmail_com",
        "avitolog_assets_sasha_v2__emp_cyplakovaleksandr153_gmail_com_month_2026-04"
      ]
    }
  },

  "entity_schemas": {

    "Project": {
      "id": "string (e.g. 'p1')",
      "emoji": "string",
      "title": "string",
      "name": "string (alias)",
      "clientType": "old | new",
      "zone": "active | archive",
      "status": "string (В работе | Готово! | Ожидают | ЛИМИТ | OFF | ...)",
      "sortOrder": "number",
      "clientPath": {
        "autoload": "boolean",
        "analytics": "boolean",
        "texts": "boolean",
        "packaging": "boolean",
        "portfolio": "boolean"
      },
      "events": "array",
      "childLines": "array of ChildLine",
      "optionalField": "string (ниша/категория)",
      "folderLink": "string (Google Drive URL)",
      "folderId": "string (Google Drive folder ID)",
      "categoryFolderId": "string (Google Drive category folder ID)",
      "mustLaunchRequired": "boolean",
      "cardsActive": "string"
    },

    "GoalProject": {
      "id": "string (e.g. 'g_1775652213264_rqcliox'  → timestamp_random)",
      "name": "string",
      "emoji": "string",
      "folderLink": "string",
      "date": "string YYYY-MM-DD",
      "weekIndex": "number (1 | 2 | 3 | 4)",
      "mainPrice": "string",
      "priceOptions": "array of string prices",
      "status": "array of status IDs (воронка прогресса)",
      "statusDates": "object { statusId: dateString }",
      "touchMarkers": "array of string",
      "touchDates": "object { markerId: dateString }",
      "tags": "array",
      "note": "string",
      "stage": "weekly | sold | working",
      "saleAmount": "string (если stage=sold)",
      "soldFromId": "string goalId (если stage=sold — ссылка на исходный weekly)",
      "workCopyOfWeekId": "string goalId (если stage=working — ссылка на weekly)"
    },

    "Client": {
      "client_id": "string UUID",
      "company": "string",
      "contact_name": "string",
      "phone": "string",
      "telegram": "string",
      "avito_account": "string",
      "client_type": "string (ООО | ИП | ...)",
      "category": "string (ниша)",
      "city": "string",
      "notes": "string",
      "positions": "string",
      "kp_count": "string",
      "createdAt": "string date",
      "folderId": "string",
      "folderLink": "string",
      "folder_name": "string",
      "categoryFolderId": "string"
    },

    "AssetRow": {
      "emoji": "string",
      "name": "string (клиент/проект)",
      "paid": "string number (оплачено ₽)",
      "expected": "string number (ожидается ₽)",
      "paymentDate": "string date",
      "startDate": "string date",
      "clientType": "new | old",
      "folderLink": "string",
      "crmClientId": "string (→ Client.client_id)",
      "goalProjectId": "string (→ GoalProject.id)"
    },

    "Achievement": {
      "type": "month_total_milestone",
      "tier": "50k | 100k | 200k | 300k",
      "monthKey": "string YYYY-MM",
      "totalAtUnlock": "number",
      "saleDate": "string YYYY-MM-DD",
      "projectName": "string",
      "at": "number (timestamp ms)"
    }
  },

